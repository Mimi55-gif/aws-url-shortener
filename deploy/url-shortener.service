[Unit]
Description=FastAPI URL Shortener Backend (Uvicorn)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/aws-url-shortener/backend
EnvironmentFile=/home/ec2-user/aws-url-shortener/backend/.env
ExecStart=/home/ec2-user/aws-url-shortener/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

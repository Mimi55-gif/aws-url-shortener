# Región de AWS donde se encuentra la tabla de DynamoDB
AWS_REGION=us-east-1

# Nombre de la tabla en Amazon DynamoDB
DYNAMODB_TABLE=UrlShortenerLinks

# URL base pública del backend en EC2 (ej. http://54.123.45.67:8000)
# Si se deja vacío, FastAPI detectará automáticamente el host y puerto de la petición
BASE_URL=http://<ip-publica-ec2>:8000

# Orígenes permitidos para CORS (separados por coma, o * para permitir el bucket S3)
CORS_ORIGINS=*

# Puerto de ejecución de Uvicorn
PORT=8000
